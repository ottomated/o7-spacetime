{
	"name": "@o7/spacetime",
	"version": "0.0.3",
	"keywords": [
		"spacetimedb",
		"svelte"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/spacetime-bindings",
		"!dist/types.js"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.6.0",
		"oxfmt": "^0.78.0",
		"publint": "^0.3.21",
		"spacetimedb": "^2.15.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"spacetimedb": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"packageManager": "pnpm@12.18.0"
}
